# AWS credentials (create an IAM user with S3, DynamoDB, and SQS access)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 bucket for built site artifacts (private bucket is fine)
AWS_BUCKET_NAME=your-private-deployment-bucket

# DynamoDB table with partition key "id" (String)
AWS_DEPLOYMENTS_TABLE=agyat-deployments

# SQS queue URL for build jobs
AWS_DEPLOY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/agyat-deployments

# Deploy worker only: your live Vercel URL (no trailing slash)
PREVIEW_BASE_URL=https://your-app.vercel.app
